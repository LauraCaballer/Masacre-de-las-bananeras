  m_Name: 8.2.2
  m_EditorClassIdentifier: 
  sentences:
  - text: "- Jorge llega a casa donde se celebra el cumplea\xF1os de su hija. "
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    voice: {fileID: 8300000, guid: 4ba332282c069e845a19e45597edb3f2, type: 3}
    sfx: {fileID: 8300000, guid: 7f169001d7bc3344db882f99d794523c, type: 3}
  - text: "\xA1Feliz cumplea\xF1os, mi princesa! "
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: 01c5a8e769a1e3b45adcd774ead5718d, type: 3}
    sfx: {fileID: 0}
  - text: "\xA1Pap\xE1, est\xE1s aqu\xED! Eres el mejor regalo de cumplea\xF1os que
      podr\xEDa pedir. "
    speaker: {fileID: 11400000, guid: 5aaf4f3842a502743a6a5e5af2b0aebb, type: 2}
    voice: {fileID: 8300000, guid: 5f8a7a216f4315344bdd7e598baa7d24, type: 3}
    sfx: {fileID: 0}
  background: {fileID: 21300000, guid: 7c0f5d507df2e9b468f40bdd84bf3612, type: 3}
