  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: 3212
  m_EditorClassIdentifier: 
  sentences:
  - text: "\xA1Chicos, no olviden la reunion ! Estamos listos para luchar por nuestros
      derechos. "
    speaker: {fileID: 11400000, guid: e77acf8e274b2f447b37a3ee48149dff, type: 2}
    voice: {fileID: 8300000, guid: 6585e9e59576f1f4c848a432cbaf580b, type: 3}
    sfx: {fileID: 0}
  - text: " Eso es lo que quer\xEDa hablarles."
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: daa4d89e8026bf64cb6a56c0b0819258, type: 3}
    sfx: {fileID: 0}
  - text: 'Tengo algunas preocupaciones personales que me impiden hacerlo. '
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: 6429522025b5efd40ba9c4495e899167, type: 3}
    sfx: {fileID: 0}
  - text: "Comprendemos que tengas tus razones, Jorge. Solo esperamos que te unas
      a nosotros en esp\xEDritu y, cuando sea posible, te unas a las acciones colectivas
      para apoyar nuestra causa. "
    speaker: {fileID: 11400000, guid: f0249a8e6b855b945a0374db78585c70, type: 2}
    voice: {fileID: 8300000, guid: 7b93a2074799f6d4e9b8359685e7edf1, type: 3}
    sfx: {fileID: 0}
  background: {fileID: 21300000, guid: 6da97d0f02b5b7a4f8d844b8c2a08611, type: 3}
  nextScene: {fileID: 11400000, guid: f0911f942de203f4a95b75102967e8c9, type: 2}
  ambience: {fileID: 0}
