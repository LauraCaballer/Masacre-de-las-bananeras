  sentences:
  - text: Debe de ser una broma!!
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: c3c41f316c1615f4392d62a7437e9dbf, type: 3}
    sfx: {fileID: 0}
  - text: Como es posible esto?!
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: 80751d5f1c600904ca63d26209a8b9d3, type: 3}
    sfx: {fileID: 0}
  - text: No es justo, para nada justo!
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: 2c0d7c5e48bf51c4eafb6828d75cdb09, type: 3}
    sfx: {fileID: 0}
  - text: 'Si tan solo... '
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: b286e4068171906498685d4a2396511e, type: 3}
