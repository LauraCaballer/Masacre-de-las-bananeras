  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: 23
  m_EditorClassIdentifier: 
  sentences:
  - text: Ven, lavate las manos y sientate, vamos a cenar
    speaker: {fileID: 11400000, guid: 1974653b2130bb1458cf1970899c5df8, type: 2}
    voice: {fileID: 8300000, guid: fe65d5d66db6d954096958e29429be26, type: 3}
    sfx: {fileID: 8300000, guid: 18641ed14f791c04a9ffdc705512d1e5, type: 3}
  - text: Muchas gracias amor, que hiciste hoy?
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: 0d5c934d950212944b5a6cc11172fd7e, type: 3}
    sfx: {fileID: 0}
  - text: Habian frijoles y algo de yuca, perdona pero no pude conseguir arroz o
      maiz.
    speaker: {fileID: 11400000, guid: 1974653b2130bb1458cf1970899c5df8, type: 2}
    voice: {fileID: 8300000, guid: df46cf50d54638648a46dc9caa7200e6, type: 3}
    sfx: {fileID: 0}
  - text: No te preocupes, eso es delicioso! ya quiero comer
    speaker: {fileID: 11400000, guid: eddfe009b49d3484d8dfb5498d6a2f17, type: 2}
    voice: {fileID: 8300000, guid: 185f6b645cb8bc04c85eee82f1dbd94d, type: 3}
    sfx: {fileID: 0}
  background: {fileID: 21300000, guid: d40bd8eea322b8d4e9df306e6c6eae67, type: 3}
  nextScene: {fileID: 11400000, guid: 3cb6be70cd3e9324580aef8ed12dbfb0, type: 2}
  ambience: {fileID: 8300000, guid: aeb30b34b4198dd4686c1e3d21f8cc60, type: 3}
